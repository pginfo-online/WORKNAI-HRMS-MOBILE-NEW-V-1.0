{
  "expo": {
    "name": "WorknAI HRMS",
    "slug": "workn-ai-hrms",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "workn-ai-hrms",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worknai.hrms",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WorknAI HRMS requires your device location to verify check-in and check-out at authorized office coordinates.",
        "NSFaceIDUsageDescription": "WorknAI HRMS uses Face ID to securely authenticate employee attendance check-ins."
      }
    },
    "android": {
      "package": "com.worknai.hrms",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WorknAI HRMS requires your location to verify office check-in."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "WorknAI HRMS uses Face ID for employee attendance verification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e55485f-7ce5-47f6-a011-6ddd958b88c0"
      }
    },
    "owner": "pginfoonline",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3e55485f-7ce5-47f6-a011-6ddd958b88c0",
      "checkAutomatically": "ON_ERROR_RECOVERY"
    }
  }
}
